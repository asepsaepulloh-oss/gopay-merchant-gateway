# Konfigurasi Server
PORT=3000

# Kredensial Login Admin
ADMIN_USER=your_admin_username
ADMIN_PASS=your_admin_password

# Cookies Facebook (Untuk scraping / integrasi autopost)
FB_C_USER=your_facebook_c_user
FB_XS=your_facebook_xs_cookie
FB_XS_LAST_UPDATED=

# Konfigurasi Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Konfigurasi Google reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Kunci Rahasia JWT
JWT_SECRET=your_jwt_secret_key_here

# Token Fonnte (Layanan Pengiriman WhatsApp)
FONNTE_TOKEN=your_fonnte_api_token
